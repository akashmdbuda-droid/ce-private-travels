---
const { lang } = Astro.props;
const translations = {
  en: { 
    text: "Excellent Budapest to Vienna transfer. Driver arrived early, the car was spotless, and securing the ride via WhatsApp was incredibly easy.",
    name: "Michael T.",
    route: "Budapest → Vienna"
  },
  de: { 
    text: "Hervorragender Transfer von Budapest nach Wien. Der Fahrer kam früh an, das Auto war makellos und die Buchung über WhatsApp war unglaublich einfach.",
    name: "Michael T.",
    route: "Budapest → Wien"
  },
  hu: { 
    text: "Kiváló Budapest-Bécs transzfer. A sofőr korán érkezett, az autó ragyogóan tiszta volt, és a fuvar WhatsApp-on keresztüli megszervezése hihetetlenül egyszerű volt.",
    name: "Michael T.",
    route: "Budapest → Bécs"
  }
};
const t = translations[lang] || translations['en'];
---

<div class="max-w-md mx-auto text-left bg-indigo-50/30 p-6 rounded-2xl border border-indigo-50">
  <div class="flex text-yellow-400 text-sm mb-3">★★★★★</div>
  <p class="text-slate-700 font-medium leading-relaxed italic mb-4">"{t.text}"</p>
  <div>
    <p class="font-black text-indigo-950 text-sm">{t.name}</p>
    <p class="text-xs font-bold text-slate-500 mt-0.5">{t.route}</p>
  </div>
</div>
