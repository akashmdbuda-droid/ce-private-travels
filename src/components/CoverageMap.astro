---
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const { data: locations } = await supabase
  .from('locations')
  .select('city, latitude, longitude, country_code');

const { lang } = Astro.props;
const translations = {
  en: { title: "Where We Drive" },
  de: { title: "Wo Wir Fahren" },
  hu: { title: "Hol Szolgáltatunk" }
};
const t = translations[lang] || translations['en'];
---

<div class="w-full max-w-5xl mx-auto my-16 px-6">
  <div class="mt-24 mb-8 text-center max-w-4xl mx-auto">
  <h3 class="text-3xl font-black text-indigo-950 mb-4">{t.title}</h3>
  <p class="text-slate-600 font-semibold mb-10 max-w-2xl mx-auto">Any city, airport, hotel or address across Hungary, Austria and Germany.</p>
  </div>
  
  <div class="bg-white border border-slate-200 p-2 rounded-3xl shadow-xl">
    <div id="coverage-map" class="w-full h-[400px] md:h-[500px] rounded-2xl z-0"></div>
  </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script define:vars={{ locations }}>
  document.addEventListener('DOMContentLoaded', () => {
    if (!document.getElementById('coverage-map')) return;
    
    // Initialize map centered roughly on Vienna (Central Europe)
    const map = L.map('coverage-map').setView([48.2082, 16.3738], 6);

    // Add clean minimal OSM tiles
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
      subdomains: 'abcd',
      maxZoom: 19
    }).addTo(map);

    // Custom marker icon
    const icon = L.divIcon({
      className: 'custom-div-icon',
      html: `<div style="background-color: #4f46e5; width: 12px; height: 12px; border-radius: 50%; border: 2px solid white; box-shadow: 0 0 4px rgba(0,0,0,0.3);"></div>`,
      iconSize: [12, 12],
      iconAnchor: [6, 6]
    });

    // Plot cities
    const latlngs = [];
    locations.forEach(loc => {
      if (loc.latitude && loc.longitude) {
        L.marker([loc.latitude, loc.longitude], { icon })
         .bindPopup(`<b>${loc.city}</b><br>${loc.country_code}`)
         .addTo(map);
         
        // Add to array for drawing route lines if needed
        if (['Budapest', 'Vienna', 'Munich', 'Salzburg', 'Prague', 'Berlin'].includes(loc.city)) {
          latlngs.push([loc.latitude, loc.longitude]);
        }
      }
    });

  });
</script>
