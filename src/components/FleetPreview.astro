---
const { lang } = Astro.props;
const translations = {
  en: { title: "Premium Vehicle Fleet", pax: "Passengers", lug: "Luggage", sedan: "Premium Sedan", van: "Executive Van", bus: "Luxury Minibus" },
  de: { title: "Premium Fahrzeugflotte", pax: "Fahrgäste", lug: "Gepäck", sedan: "Premium Limousine", van: "Executive Van", bus: "Luxus Minibus" },
  hu: { title: "Prémium Gépjárműflotta", pax: "Utasok", lug: "Csomagok", sedan: "Prémium Szedán", van: "Executive Furgon", bus: "Luxus Minibusz" }
};
const t = translations[lang] || translations['en'];

const fleet = [
  { name: t.sedan, img: "sedan.png", pax: "1-4", lug: "3" },
  { name: t.van, img: "van.png", pax: "5-8", lug: "8" },
  { name: t.bus, img: "minibus.png", pax: "9-16", lug: "16" }
];
---

<div class="mt-20 mb-16 max-w-5xl mx-auto">
  <h3 class="text-3xl font-black text-indigo-950 mb-10 text-center md:text-left">{t.title}</h3>
  
  <div class="grid md:grid-cols-3 gap-6">
    {fleet.map(v => (
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden group">
        <div class="aspect-[16/10] bg-slate-100 relative overflow-hidden">
          <img src={`${import.meta.env.BASE_URL}/vehicles/${v.img}`.replace(/\/\//g, '/')} alt={v.name} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
        </div>
        <div class="p-6">
          <h4 class="font-black text-lg text-slate-900 mb-4">{v.name}</h4>
          <div class="flex items-center gap-4 text-sm font-semibold text-slate-600">
            <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg> {v.pax} {t.pax}</span>
            <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg> {v.lug} {t.lug}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
