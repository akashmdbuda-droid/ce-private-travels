---
const { lang } = Astro.props;
const translations = {
  en: { title: "Meet Your Drivers", btn: "Meet Our Team", exp: "Years Experience", spec: "Specialist" },
  de: { title: "Lernen Sie Ihre Fahrer Kennen", btn: "Unser Team Kennenlernen", exp: "Jahre Erfahrung", spec: "Spezialist" },
  hu: { title: "Ismerje meg Sofőrjeinket", btn: "Ismerje meg Csapatunkat", exp: "Év Tapasztalat", spec: "Specialista" }
};
const t = translations[lang] || translations['en'];

const drivers = [
  { name: "Henry", langs: "English • German", stats: `8 ${t.exp}` },
  { name: "Fawzi", langs: "English • German • Arabic", stats: `Airport & Long Distance ${t.spec}` }
];
---

<div class="mt-20 mb-16 max-w-5xl mx-auto">
  <div class="flex justify-between items-end mb-10">
    <h3 class="text-3xl font-black text-indigo-950">{t.title}</h3>
    <a href={`${import.meta.env.BASE_URL}/${lang === 'de' ? 'de/fahrer' : lang === 'hu' ? 'hu/soforok' : 'en/drivers'}`.replace(/\/\//g, '/')} class="hidden md:inline-block bg-white border border-slate-200 text-slate-700 hover:border-indigo-600 hover:text-indigo-600 font-bold px-6 py-2.5 rounded-xl transition text-sm">
      {t.btn}
    </a>
  </div>
  
  <div class="grid md:grid-cols-2 gap-6">
    {drivers.map(d => (
      <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-6">
        <div class="w-20 h-20 bg-indigo-50 rounded-full flex items-center justify-center text-indigo-300 font-black text-3xl flex-shrink-0 border-4 border-white shadow-md">
          {d.name.charAt(0)}
        </div>
        <div>
          <h4 class="font-black text-xl text-slate-900 mb-1">{d.name}</h4>
          <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">{d.langs}</p>
          <p class="text-sm text-indigo-600 font-bold">{d.stats}</p>
        </div>
      </div>
    ))}
  </div>
  
  <div class="mt-6 text-center md:hidden">
    <a href={`${import.meta.env.BASE_URL}/${lang === 'de' ? 'de/fahrer' : lang === 'hu' ? 'hu/soforok' : 'en/drivers'}`.replace(/\/\//g, '/')} class="inline-block bg-white border border-slate-200 text-slate-700 font-bold px-6 py-3 rounded-xl w-full text-sm">
      {t.btn}
    </a>
  </div>
</div>
