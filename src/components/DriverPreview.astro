---
const { lang } = Astro.props;
const translations = {
  en: { title: "Meet Your Drivers", btn: "Meet Our Team", exp: "Years Experience", spec: "Specialist" },
  de: { title: "Lernen Sie Ihre Fahrer Kennen", btn: "Unser Team Kennenlernen", exp: "Jahre Erfahrung", spec: "Spezialist" },
  hu: { title: "Ismerje meg Sofőrjeinket", btn: "Ismerje meg Csapatunkat", exp: "Év Tapasztalat", spec: "Specialista" }
};
const t = translations[lang] || translations['en'];

const drivers = [
  { name: "Henry", langs: "English • German", stats: `8 ${t.exp}` },
  { name: "Fawzi", langs: "English • German • Arabic", stats: `Airport & Long Distance ${t.spec}` }
];
---

<div class="max-w-md mx-auto text-left">
  <div class="grid grid-cols-2 gap-4">
    {drivers.map(d => (
      <div class="bg-white p-3 rounded-2xl border border-slate-100 shadow-sm flex flex-col items-center text-center">
        <div class="w-12 h-12 bg-indigo-50 rounded-full flex items-center justify-center text-indigo-300 font-black text-xl flex-shrink-0 border-2 border-white shadow-sm mb-2">
          {d.name.charAt(0)}
        </div>
        <h4 class="font-black text-sm text-slate-900 mb-0.5">{d.name}</h4>
        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">{d.langs}</p>
      </div>
    ))}
  </div>
  
  <div class="mt-4 text-center">
    <a href={`${import.meta.env.BASE_URL}/${lang === 'de' ? 'de/fahrer' : lang === 'hu' ? 'hu/soforok' : 'en/drivers'}`.replace(/\/\//g, '/')} class="inline-block text-indigo-600 hover:text-indigo-800 font-bold text-xs tracking-wide">
      {t.btn} →
    </a>
  </div>
</div>
