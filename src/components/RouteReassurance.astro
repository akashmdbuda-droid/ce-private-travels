---
const { lang } = Astro.props;
const translations = {
  en: { title: "Don't See Your Route?", desc: "We provide transfers between any city, airport or hotel in Hungary, Austria and Germany." },
  de: { title: "Ihre Route nicht dabei?", desc: "Wir bieten Transfers zwischen jeder Stadt, jedem Flughafen oder Hotel in Ungarn, Österreich und Deutschland an." },
  hu: { title: "Nem találja az útvonalát?", desc: "Bármely város, repülőtér vagy szálloda között biztosítunk transzfert Magyarországon, Ausztriában és Németországban." }
};
const t = translations[lang] || translations['en'];
---

<div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-6 text-center max-w-3xl mx-auto mb-16 shadow-sm">
  <h4 class="text-lg font-black text-indigo-900 mb-2">{t.title}</h4>
  <p class="text-sm font-semibold text-indigo-700/80">{t.desc}</p>
</div>
