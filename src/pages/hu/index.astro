---
import Layout from '../../layouts/Layout.astro';
import TrustBar from '../../components/TrustBar.astro';
import EstimateForm from '../../components/EstimateForm';
import CoverageMap from '../../components/CoverageMap.astro';
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const { data: locations } = await supabase
  .from('locations')
  .select('id, city, latitude, longitude, country_code')
  .order('city', { ascending: true });

const mainSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "EuroDrive Private Transfers",
  "description": "Prémium magán transzfer szolgáltatások Magyarország, Ausztria és Németország között.",
  "telephone": "+36301234567",
  "priceRange": "EUR",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Budapest",
    "addressCountry": "HU"
  }
};
---
<Layout title="Prémium Magán Transzfer | EuroDrive" description="Háztól-házig prémium sofőrszolgálat Magyarország, Ausztria és Németország között. Kalkulálja ki az árat azonnal, rejtett költségek nélkül." lang="hu" slug="hu">
  <script type="application/ld+json" set:html={JSON.stringify(mainSchema)} />

  <section class="max-w-5xl mx-auto px-6 py-16 md:py-24 text-center">
    <span class="text-xs font-extrabold uppercase tracking-widest text-blue-600 bg-blue-50 px-4 py-1.5 rounded-full shadow-sm">Közvetlen Európai Személyszállítás</span>
    <h1 class="text-4xl md:text-6xl font-black text-indigo-950 tracking-tight max-w-4xl mx-auto mt-6 mb-6 leading-tight">
      Magán Transzferek Rejtett Közvetítői Díjak Nélkül
    </h1>
    <p class="text-base md:text-lg text-slate-600 max-w-2xl mx-auto mb-12 font-medium">
      Tapasztalja meg a közvetlen háztól-házig utazást Magyarország, Ausztria és Németország között. Prémium gépjárműflotta és többnyelvű, tapasztalt sofőrök várják.
    </p>

    <div class="mb-16">
      <EstimateForm client:load locations={locations || []} lang="hu" />
    </div>
    
    <div class="mt-24 mb-16 text-left max-w-5xl mx-auto">
      <h3 class="text-3xl font-black text-indigo-950 mb-10 text-center">Miért válassza az EuroDrive-ot?</h3>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
          <h4 class="font-black text-lg text-slate-900 mb-2">Közvetlen Árazás</h4>
          <p class="text-sm text-slate-600 font-medium">Nincsenek ügynökségi jutalékok. Közvetlenül a sofőrtől rendel.</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
          <h4 class="font-black text-lg text-slate-900 mb-2">Háztól-Házig Szolgáltatás</h4>
          <p class="text-sm text-slate-600 font-medium">Közvetlen felvétel és érkezés, hosszas átszállások nélkül.</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
          <h4 class="font-black text-lg text-slate-900 mb-2">Rugalmas Megállók</h4>
          <p class="text-sm text-slate-600 font-medium">Opcionális kávészünetek és városnézés a hosszú távú utazások során.</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
          <h4 class="font-black text-lg text-slate-900 mb-2">Többnyelvű Sofőrök</h4>
          <p class="text-sm text-slate-600 font-medium">Angolul, németül és magyarul beszélő profi sofőrök.</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
          <h4 class="font-black text-lg text-slate-900 mb-2">Fix Ár Garancia</h4>
          <p class="text-sm text-slate-600 font-medium">Nincsenek rejtett költségek. A megegyezett ár a végső összeg.</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
          <h4 class="font-black text-lg text-slate-900 mb-2">Valódi Emberi Támogatás</h4>
          <p class="text-sm text-slate-600 font-medium">Közvetlen kommunikáció WhatsApp-on keresztül automatikus chatbotok nélkül.</p>
        </div>
      </div>
    </div>

    <CoverageMap />

    <div class="mt-20 mb-16 text-left max-w-5xl mx-auto">
      <h3 class="text-2xl font-black text-indigo-950 mb-6 text-center md:text-left">Népszerű Útvonalak</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {[
          {p: 'Budapest', d: 'Vienna'},
          {p: 'Vienna', d: 'Budapest'},
          {p: 'Budapest', d: 'Munich'},
          {p: 'Vienna', d: 'Salzburg'},
          {p: 'Salzburg', d: 'Munich'},
          {p: 'Budapest', d: 'Prague'},
          {p: 'Vienna', d: 'Prague'},
          {p: 'Frankfurt', d: 'Cologne'}
        ].map(route => {
          const routeSlug = `${route.p.toLowerCase()}-to-${route.d.toLowerCase()}`.replace(/\s+/g, '-');
          return (
            <a href={`${import.meta.env.BASE_URL}/routes/${routeSlug}`.replace(/\/\//g, '/')} class="block bg-slate-50 border border-slate-100 hover:border-blue-300 hover:shadow-md transition-all rounded-xl p-4 text-sm font-semibold text-slate-700">
              <span class="text-xs text-slate-400 block mb-1">Honnan: {route.p}</span>
              Hova: {route.d}
            </a>
          );
        })}
      </div>
    </div>

    <TrustBar lang="hu" />
  </section>
</Layout>
