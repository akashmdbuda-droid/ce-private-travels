---
import Layout from '../../layouts/Layout.astro';
import TrustBar from '../../components/TrustBar.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import EstimateForm from '../../components/EstimateForm';
import DriverPreview from '../../components/DriverPreview.astro';
import FleetPreview from '../../components/FleetPreview.astro';
import Reviews from '../../components/Reviews.astro';
import FAQ from '../../components/FAQ.astro';
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const { data: locations } = await supabase
  .from('locations')
  .select('id, city, latitude, longitude, country_code')
  .order('city', { ascending: true });

const mainSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "EuroDrive Private Transfers",
  "description": "Prémium magán transzfer szolgáltatások Magyarország, Ausztria és Németország között.",
  "telephone": "+36301234567",
  "priceRange": "EUR",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Budapest",
    "addressCountry": "HU"
  }
};
---
<Layout title="Prémium Magán Transzfer | EuroDrive" description="Háztól-házig prémium sofőrszolgálat Magyarország, Ausztria és Németország között. Kalkulálja ki az árat azonnal, rejtett költségek nélkül." lang="hu" slug="hu">
  <script type="application/ld+json" set:html={JSON.stringify(mainSchema)} />

  <section class="max-w-6xl mx-auto px-6 py-12 md:py-20 text-center">
    <span class="text-xs font-extrabold uppercase tracking-widest text-blue-600 bg-blue-50 px-4 py-1.5 rounded-full shadow-sm">Közvetlen Európai Személyszállítás</span>
    <h1 class="text-4xl md:text-6xl font-black text-indigo-950 tracking-tight max-w-4xl mx-auto mt-6 mb-6 leading-tight">
      Magán Transzferek Magyarország, Ausztria és Németország Között
    </h1>
    <p class="text-base md:text-lg text-slate-600 max-w-2xl mx-auto mb-6 font-medium">
      Közvetlen árak, többnyelvű sofőrök és személyes WhatsApp ügyfélszolgálat. Kérje a legjobb ajánlatot perceken belül.
    </p>

    <TrustStrip lang="hu" />

    <div class="mb-4 max-w-5xl mx-auto">
      <EstimateForm client:load locations={locations || []} lang="hu" />
    </div>
    
    <TrustBar lang="hu" />

    <div class="mt-8 mb-20 max-w-5xl mx-auto">
      <div class="grid md:grid-cols-3 gap-4 text-center">
        <div class="bg-indigo-50/50 p-4 rounded-xl border border-indigo-50"><p class="font-bold text-indigo-900 text-sm">✓ Közvetlen flottás árak</p></div>
        <div class="bg-indigo-50/50 p-4 rounded-xl border border-indigo-50"><p class="font-bold text-indigo-900 text-sm">✓ Háztól-házig szolgáltatás</p></div>
        <div class="bg-indigo-50/50 p-4 rounded-xl border border-indigo-50"><p class="font-bold text-indigo-900 text-sm">✓ Valódi WhatsApp ügyfélszolgálat</p></div>
      </div>
    </div>

    <div class="flex flex-col md:flex-row items-center justify-center gap-8 md:gap-12 max-w-5xl mx-auto mt-20 mb-20">
      <div class="w-full md:w-1/2">
        <Reviews lang="hu" />
      </div>
      <div class="w-full md:w-1/2">
        <DriverPreview lang="hu" />
      </div>
    </div>

    <FleetPreview lang="hu" />
    <FAQ lang="hu" />
  </section>
</Layout>
