---
import Layout from '../../layouts/Layout.astro';
import TrustBar from '../../components/TrustBar.astro';
import EstimateForm from '../../components/EstimateForm';
import { createClient } from '@supabase/supabase-js';

export async function getStaticPaths() {
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const { data: locations } = await supabase
    .from('locations')
    .select('id, city, latitude, longitude, country_code');

  const paths = [];

  for (let i = 0; i < locations.length; i++) {
    for (let j = 0; j < locations.length; j++) {
      if (i !== j) {
        const p1 = locations[i];
        const p2 = locations[j];
        const slug = `${p1.city.toLowerCase()}-to-${p2.city.toLowerCase()}`.replace(/\s+/g, '-');
        
        paths.push({
          params: { route: slug },
          props: { pickup: p1, destination: p2, allLocations: locations }
        });
      }
    }
  }

  return paths;
}

const { pickup, destination, allLocations } = Astro.props;

const mainSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `How long does the private transfer from ${pickup.city} to ${destination.city} take?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The exact travel time depends on traffic and border crossing conditions, but our private drivers take the fastest direct highway route between ${pickup.city} and ${destination.city}.`
      }
    },
    {
      "@type": "Question",
      "name": `Do you provide child seats for the trip to ${destination.city}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes! We provide premium child seats free of charge for all transfers. Please let your operator know via WhatsApp when booking your ride to ${destination.city}.`
      }
    },
    {
      "@type": "Question",
      "name": `Are there any hidden fees or upfront credit card charges for the ${pickup.city} transfer?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Absolutely not. The price range you secure via WhatsApp is final and includes highway vignettes and direct fueling. You pay your driver directly with zero upfront automated charges.`
      }
    }
  ]
};
---
<Layout 
  title={`Private Transfer: ${pickup.city} to ${destination.city} | EuroDrive`} 
  description={`Book a premium private driver from ${pickup.city} to ${destination.city}. Door-to-door luxury transport across Central Europe.`} 
  lang="en" 
  slug={`routes/${Astro.params.route}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(mainSchema)} />

  <section class="max-w-5xl mx-auto px-6 py-16 md:py-24 text-center">
    <span class="text-xs font-extrabold uppercase tracking-widest text-blue-600 bg-blue-50 px-4 py-1.5 rounded-full shadow-sm">Route Hub</span>
    <h1 class="text-4xl md:text-6xl font-black text-indigo-950 tracking-tight max-w-4xl mx-auto mt-6 mb-6 leading-tight">
      Private Transfer from {pickup.city} to {destination.city}
    </h1>
    <p class="text-base md:text-lg text-slate-600 max-w-2xl mx-auto mb-12 font-medium">
      Secure a door-to-door luxury ride from {pickup.city} ({pickup.country_code}) to {destination.city} ({destination.country_code}). No hidden agency fees, direct operator pricing.
    </p>

    <div class="mb-16">
      <EstimateForm 
        client:load 
        locations={allLocations} 
        lang="en" 
        initialPickup={pickup.city} 
        initialDestination={destination.city} 
      />
    </div>

    <TrustBar lang="en" />
  </section>
</Layout>
