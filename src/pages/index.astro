---
import Layout from '../layouts/Layout.astro';
import TrustBar from '../components/TrustBar.astro';
import TrustStrip from '../components/TrustStrip.astro';
import EstimateForm from '../components/EstimateForm';
import DriverPreview from '../components/DriverPreview.astro';
import FleetPreview from '../components/FleetPreview.astro';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const { data: locations } = await supabase
  .from('locations')
  .select('id, city, latitude, longitude, country_code')
  .order('city', { ascending: true });

const mainSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "EuroDrive Private Transfers",
  "description": "Premium private cross-border driver networks linking Hungary, Austria, and Germany directly.",
  "telephone": "+36301234567",
  "priceRange": "EUR",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Budapest",
    "addressCountry": "HU"
  }
};
---
<Layout title="Premium Private Intercity Transfers | EuroDrive" description="Door-to-door luxury private driver networks across Hungary, Austria, and Germany. Calculate real pricing ranges instantly and secure execution via WhatsApp." lang="en" slug="">
  <script type="application/ld+json" set:html={JSON.stringify(mainSchema)} />

  <section class="max-w-6xl mx-auto px-6 py-12 md:py-20 text-center">
    <span class="text-xs font-extrabold uppercase tracking-widest text-blue-600 bg-blue-50 px-4 py-1.5 rounded-full shadow-sm">Direct European Carrier</span>
    <h1 class="text-4xl md:text-6xl font-black text-indigo-950 tracking-tight max-w-4xl mx-auto mt-6 mb-6 leading-tight">
      Private Transfers Across Hungary, Austria & Germany
    </h1>
    <p class="text-base md:text-lg text-slate-600 max-w-2xl mx-auto mb-6 font-medium">
      Direct pricing, multilingual drivers, and personal WhatsApp support. Get your best quote in minutes.
    </p>

    <TrustStrip lang="en" />

    <div class="mb-4 max-w-5xl mx-auto">
      <EstimateForm client:load locations={locations || []} lang="en" />
    </div>
    
    <TrustBar lang="en" />

    <div class="mt-8 mb-20 max-w-5xl mx-auto">
      <div class="grid md:grid-cols-3 gap-4 text-center">
        <div class="bg-indigo-50/50 p-4 rounded-xl border border-indigo-50"><p class="font-bold text-indigo-900 text-sm">✓ Direct fleet pricing</p></div>
        <div class="bg-indigo-50/50 p-4 rounded-xl border border-indigo-50"><p class="font-bold text-indigo-900 text-sm">✓ Door-to-door service</p></div>
        <div class="bg-indigo-50/50 p-4 rounded-xl border border-indigo-50"><p class="font-bold text-indigo-900 text-sm">✓ Real WhatsApp support</p></div>
      </div>
    </div>

    <div class="flex flex-col md:flex-row items-center justify-center gap-8 md:gap-12 max-w-5xl mx-auto mt-20 mb-20">
      <div class="w-full md:w-1/2">
        <Reviews lang="en" />
      </div>
      <div class="w-full md:w-1/2">
        <DriverPreview lang="en" />
      </div>
    </div>

    <FleetPreview lang="en" />
    <FAQ lang="en" />
  </section>
</Layout>
