---
import Layout from '../layouts/Layout.astro';
import TrustBar from '../components/TrustBar.astro';
import EstimateForm from '../components/EstimateForm';
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const { data: locations } = await supabase
  .from('locations')
  .select('id, city, latitude, longitude, country_code')
  .order('city', { ascending: true });

const mainSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "EuroDrive Private Transfers",
  "description": "Premium private cross-border driver networks linking Hungary, Austria, and Germany directly.",
  "telephone": "+36301234567",
  "priceRange": "EUR",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Budapest",
    "addressCountry": "HU"
  }
};
---
<Layout title="Premium Private Intercity Transfers | EuroDrive" description="Door-to-door luxury private driver networks across Hungary, Austria, and Germany. Calculate real pricing ranges instantly and secure execution via WhatsApp." lang="en" slug="">
  <script type="application/ld+json" set:html={JSON.stringify(mainSchema)} />

  <section class="max-w-5xl mx-auto px-6 py-16 md:py-24 text-center">
    <span class="text-xs font-extrabold uppercase tracking-widest text-blue-600 bg-blue-50 px-4 py-1.5 rounded-full shadow-sm">Direct European Carrier</span>
    <h1 class="text-4xl md:text-6xl font-black text-indigo-950 tracking-tight max-w-4xl mx-auto mt-6 mb-6 leading-tight">
      Private Trans-Border Journeys Free From Agency Markups
    </h1>
    <p class="text-base md:text-lg text-slate-600 max-w-2xl mx-auto mb-12 font-medium">
      Experience door-to-door tracking absolute priority travel across Hungary, Austria, and Germany. Complete executive fleet options driven by multilingual route experts.
    </p>

    <div class="mb-16">
      <EstimateForm client:load locations={locations || []} lang="en" />
    </div>
    
    <div class="mt-20 mb-16 text-left max-w-5xl mx-auto">
      <h3 class="text-2xl font-black text-indigo-950 mb-6 text-center md:text-left">Most Requested Routes</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {[
          {p: 'Budapest', d: 'Vienna'},
          {p: 'Vienna', d: 'Budapest'},
          {p: 'Salzburg', d: 'Munich'},
          {p: 'Munich', d: 'Salzburg'},
          {p: 'Budapest', d: 'Prague'},
          {p: 'Vienna', d: 'Prague'},
          {p: 'Berlin', d: 'Dresden'},
          {p: 'Frankfurt', d: 'Cologne'}
        ].map(route => {
          const routeSlug = `${route.p.toLowerCase()}-to-${route.d.toLowerCase()}`.replace(/\s+/g, '-');
          return (
            <a href={`/ce-private-travels/routes/${routeSlug}`} class="block bg-slate-50 border border-slate-100 hover:border-blue-300 hover:shadow-md transition-all rounded-xl p-4 text-sm font-semibold text-slate-700">
              <span class="text-xs text-slate-400 block mb-1">From {route.p}</span>
              To {route.d}
            </a>
          );
        })}
      </div>
    </div>

    <TrustBar lang="en" />
  </section>
</Layout>
