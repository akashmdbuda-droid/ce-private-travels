---
import Layout from '../../layouts/Layout.astro';
import TrustBar from '../../components/TrustBar.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import EstimateForm from '../../components/EstimateForm';
import DriverPreview from '../../components/DriverPreview.astro';
import FleetPreview from '../../components/FleetPreview.astro';
import Reviews from '../../components/Reviews.astro';
import FAQ from '../../components/FAQ.astro';
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const { data: locations } = await supabase
  .from('locations')
  .select('id, city, latitude, longitude, country_code')
  .order('city', { ascending: true });

const mainSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "EuroDrive Private Transfers",
  "description": "Premium private cross-border driver networks linking Hungary, Austria, and Germany directly.",
  "telephone": "+36301234567",
  "priceRange": "EUR",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Budapest",
    "addressCountry": "HU"
  }
};
---
<Layout title="Premium Private Intercity Transfers | EuroDrive" description="Door-to-door luxury private driver networks across Hungary, Austria, and Germany. Calculate real pricing ranges instantly and secure execution via WhatsApp." lang="de" slug="de">
  <script type="application/ld+json" set:html={JSON.stringify(mainSchema)} />

  <section class="max-w-6xl mx-auto px-6 py-12 md:py-20 text-center">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 bg-indigo-50 rounded-full px-4 py-1.5 text-xs font-bold text-indigo-700 border border-indigo-100 shadow-sm">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
        </span>
        Aktuelle Anfrage: Wien → Budapest (vor 3 Min)
      </div>
    </div>
    
    <h1 class="text-4xl md:text-6xl font-black text-indigo-950 tracking-tight max-w-4xl mx-auto mt-2 mb-6 leading-tight">
      Private Transfers durch Ungarn, Österreich & Deutschland
    </h1>
    <p class="text-base md:text-lg text-slate-600 max-w-2xl mx-auto mb-6 font-medium">
      Direkte Flottenpreise ohne Agenturprovisionen. Mehrsprachige Fahrer, Tür-zu-Tür Service und persönlicher WhatsApp-Support.
    </p>

    <TrustStrip lang="de" />

    <div class="mb-4 max-w-5xl mx-auto">
      <EstimateForm client:load locations={locations || []} lang="de" />
    </div>
    
    <TrustBar lang="de" />

    <div class="mt-8 mb-20 max-w-5xl mx-auto">
      <div class="grid md:grid-cols-3 gap-4 text-center">
        <div class="bg-indigo-50/50 p-4 rounded-xl border border-indigo-50"><p class="font-bold text-indigo-900 text-sm">✓ Direkte Flottenpreise</p></div>
        <div class="bg-indigo-50/50 p-4 rounded-xl border border-indigo-50"><p class="font-bold text-indigo-900 text-sm">✓ Tür-zu-Tür Service</p></div>
        <div class="bg-indigo-50/50 p-4 rounded-xl border border-indigo-50"><p class="font-bold text-indigo-900 text-sm">✓ Echter WhatsApp Support</p></div>
      </div>
    </div>

    <div class="flex flex-col md:flex-row items-center justify-center gap-8 md:gap-12 max-w-5xl mx-auto mt-20 mb-20">
      <div class="w-full md:w-1/2">
        <Reviews lang="de" />
      </div>
      <div class="w-full md:w-1/2">
        <DriverPreview lang="de" />
      </div>
    </div>

    <FleetPreview lang="de" />
    <FAQ lang="de" />
  </section>
</Layout>
