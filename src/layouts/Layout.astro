---
interface Props {
  title: string;
  description: string;
  lang: 'en' | 'de' | 'hu';
  slug: string;
  schema?: object;
}

const { title, description, lang, slug, schema } = Astro.props;
const siteUrl = 'https://eurodrive-transfers.com';
const cleanSlug = slug.replace(/^\/|\/$/g, '');
const canonicalUrl = `${siteUrl}${lang === 'en' ? '' : '/' + lang}/${cleanSlug}`;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="alternate" hreflang="en" href={`${siteUrl}/${cleanSlug}`} />
    <link rel="alternate" hreflang="de" href={`${siteUrl}/de/${cleanSlug}`} />
    <link rel="alternate" hreflang="hu" href={`${siteUrl}/hu/${cleanSlug}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/${cleanSlug}`} />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased font-sans min-h-screen flex flex-col">
    <header class="bg-white/80 backdrop-blur-md border-b border-slate-100 py-4 px-6 sticky top-0 z-50 shadow-sm">
      <div class="max-w-6xl mx-auto flex justify-between items-center">
        <a href={lang === 'en' ? '/' : `/${lang}`} class="text-xl font-black tracking-tight text-indigo-950">
          EURO<span class="text-blue-600">DRIVE</span>
        </a>
        <nav class="flex items-center gap-6 text-sm font-bold text-slate-600">
          <a href="/" class={lang === 'en' ? 'text-blue-600' : 'hover:text-blue-600 transition'}>EN</a>
          <a href="/de" class={lang === 'de' ? 'text-blue-600' : 'hover:text-blue-600 transition'}>DE</a>
          <a href="/hu" class={lang === 'hu' ? 'text-blue-600' : 'hover:text-blue-600 transition'}>HU</a>
        </nav>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-slate-900 text-slate-400 py-12 px-6 border-t border-slate-800 text-xs text-center">
      <div class="max-w-6xl mx-auto space-y-4">
        <p class="font-bold text-slate-200">EuroDrive Private Regional Transportation Network</p>
        <p>Premium point-to-point operations encompassing Hungary, Austria, and Germany. Response execution limits maintained strictly under 30 minutes.</p>
        <p class="text-slate-600">&copy; {new Date().getFullYear()} EuroDrive. All structural and operations parameters reserved.</p>
      </div>
    </footer>
  </body>
</html>
