---
interface Props {
  title: string;
  description: string;
  lang: 'en' | 'de' | 'hu';
  slug: string;
  schema?: object;
}

const { title, description, lang, slug, schema } = Astro.props;
const siteUrl = 'https://eurodrive-transfers.com';
const cleanSlug = slug.replace(/^\/|\/$/g, '');
const canonicalUrl = `${siteUrl}${lang === 'en' ? '' : '/' + lang}/${cleanSlug}`;

const translations = {
  en: { wa: "Get My Quote on WhatsApp" },
  de: { wa: "Mein Angebot über WhatsApp erhalten" },
  hu: { wa: "Kérem az ajánlatot WhatsApp-on" }
};
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="alternate" hreflang="en" href={`${siteUrl}/${cleanSlug}`} />
    <link rel="alternate" hreflang="de" href={`${siteUrl}/de/${cleanSlug}`} />
    <link rel="alternate" hreflang="hu" href={`${siteUrl}/hu/${cleanSlug}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/${cleanSlug}`} />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased font-sans min-h-screen flex flex-col">
    <header class="bg-white/80 backdrop-blur-md border-b border-slate-100 py-4 px-6 sticky top-0 z-50 shadow-sm">
      <div class="max-w-6xl mx-auto flex justify-between items-center">
        <a href={`${import.meta.env.BASE_URL}/${lang === 'en' ? '' : lang}`.replace(/\/\//g, '/')} class="text-xl font-black tracking-tight text-indigo-950">
          EURO<span class="text-blue-600">DRIVE</span>
        </a>
        <div class="hidden md:flex items-center text-xs font-bold bg-green-50 text-green-700 px-3 py-1.5 rounded-full shadow-sm">
          <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse mr-2"></span>
          Avg Response Time: 12 Minutes
        </div>
        <nav class="flex items-center gap-6 text-sm font-bold text-slate-600">
          <a href={`${import.meta.env.BASE_URL}/${lang === 'de' ? 'de/fahrer' : lang === 'hu' ? 'hu/soforok' : 'en/drivers'}`.replace(/\/\//g, '/')} class="hidden md:inline hover:text-indigo-900 transition">Our Drivers</a>
          <a href={import.meta.env.BASE_URL} class={lang === 'en' ? 'text-blue-600' : 'hover:text-blue-600 transition'}>EN</a>
          <a href={`${import.meta.env.BASE_URL}/de`.replace(/\/\//g, '/')} class={lang === 'de' ? 'text-blue-600' : 'hover:text-blue-600 transition'}>DE</a>
          <a href={`${import.meta.env.BASE_URL}/hu`.replace(/\/\//g, '/')} class={lang === 'hu' ? 'text-blue-600' : 'hover:text-blue-600 transition'}>HU</a>
        </nav>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-indigo-950 py-16 text-center border-t border-indigo-900 mt-auto">
      <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-4 gap-8 text-left">
        <div>
          <a href={`${import.meta.env.BASE_URL}/${lang === 'en' ? '' : lang}`.replace(/\/\//g, '/')} class="text-xl font-black tracking-tight text-white mb-6 block">
            EURO<span class="text-blue-500">DRIVE</span>
          </a>
          <p class="text-indigo-200/60 text-sm font-medium">Direct European cross-border carrier network.</p>
        </div>
        <div>
          <h5 class="text-white font-bold mb-4">Quick Links</h5>
          <ul class="space-y-2 text-indigo-300 text-sm font-medium">
            <li><a href={`${import.meta.env.BASE_URL}routes/budapest-to-vienna`} class="hover:text-white transition">Budapest Transfers</a></li>
            <li><a href={`${import.meta.env.BASE_URL}routes/vienna-to-salzburg`} class="hover:text-white transition">Vienna Transfers</a></li>
            <li><a href={`${import.meta.env.BASE_URL}`} class="hover:text-white transition">Airport Pickups</a></li>
          </ul>
        </div>
        <div>
          <h5 class="text-white font-bold mb-4">Company</h5>
          <ul class="space-y-2 text-indigo-300 text-sm font-medium">
            <li><a href={`${import.meta.env.BASE_URL}/${lang === 'de' ? 'de/fahrer' : lang === 'hu' ? 'hu/soforok' : 'en/drivers'}`.replace(/\/\//g, '/')} class="hover:text-white transition">Our Drivers</a></li>
            <li><a href={`${import.meta.env.BASE_URL}`} class="hover:text-white transition">Vehicle Fleet</a></li>
          </ul>
        </div>
        <div>
          <h5 class="text-white font-bold mb-4">Contact</h5>
          <a href="https://wa.me/436601234567" target="_blank" class="inline-flex items-center gap-2 text-sm font-bold bg-[#25D366]/10 text-[#25D366] px-4 py-2 rounded-xl hover:bg-[#25D366]/20 transition">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 0C5.385 0 .002 5.383.002 12.032c0 2.12.553 4.188 1.602 6.012l-1.644 6.007 6.147-1.614c1.761.956 3.75 1.458 5.924 1.458 6.645 0 12.029-5.383 12.029-12.031C24.06 5.383 18.676 0 12.031 0zm3.896 17.135c-.173.491-.989.96-1.428 1.011-.44.051-1.01.127-3.3-1.01-2.766-1.373-4.542-4.225-4.679-4.409-.138-.184-1.12-1.493-1.12-2.846 0-1.352.705-2.016.963-2.293.258-.277.567-.346.756-.346.189 0 .378.005.541.012.167.008.396-.062.62.483.224.546.756 1.842.825 1.98.069.138.115.3.023.484-.092.184-.138.3-.276.46-.138.161-.29.358-.415.485-.138.138-.283.288-.126.565.155.276.691 1.152 1.482 1.86.102.091.206.18.313.266.702.564 1.343.837 1.62.977.276.138.438.115.6-.069.161-.184.691-.806.875-1.082.184-.276.368-.23.621-.138.253.092 1.611.76 1.887.898.276.138.46.207.529.322.069.115.069.667-.104 1.158z"/></svg>
            Support on WhatsApp
          </a>
        </div>
      </div>
      <div class="mt-12 text-indigo-400/30 text-xs font-semibold">
        &copy; {new Date().getFullYear()} EuroDrive Private Transport Network. All rights reserved.
      </div>
    </footer>

    <!-- Global Floating Actions -->
    <div class="fixed bottom-6 right-6 flex flex-col gap-3 z-50">
      <a href="tel:+36308285603" class="md:hidden flex items-center justify-center w-14 h-14 bg-indigo-600 text-white rounded-full shadow-lg shadow-indigo-600/30 hover:bg-indigo-700 transition transform hover:scale-105">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
      </a>
      <a href="https://wa.me/36308285603" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 bg-[#25D366] text-white px-5 py-3.5 rounded-full shadow-lg shadow-green-600/30 hover:bg-[#1ebd5a] transition transform hover:-translate-y-1 font-black tracking-tight text-sm">
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
        <span>{translations[lang].wa}</span>
      </a>
    </div>
  </body>
</html>
